# Copy to .env.local and fill in. Without Supabase set, the app runs in demo
# mode using built-in sample tenants (lib/mock-data.ts).

# ── App ─────────────────────────────────────────────────────────────────────
# The platform's own domain. Subdomains of this are tenant sites; anything
# else is treated as a customer custom domain. Use "localhost" in dev.
NEXT_PUBLIC_APP_DOMAIN=localhost

# Public base URL of the app itself (used for Stripe checkout redirects).
# http://localhost:3000 in dev, https://kovasite.com in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated operator emails (get the /admin override). Everyone else is a client.
STAFF_EMAILS=

# Who receives the "payment received" alert when a client pays. Comma-separated.
# Falls back to STAFF_EMAILS if unset; if BOTH are empty, no staff alert is sent.
PAYMENT_NOTIFY_EMAILS=

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co

# Publishable (anon) key — used by the public site + signed-in clients.
# RLS-enforced and safe even if exposed.
SUPABASE_PUBLISHABLE_KEY=

# Secret (service_role) key — server-only, BYPASSES RLS. Used by the operator
# /admin and the Stripe webhook. Never expose to the browser.
SUPABASE_SECRET_KEY=

# ── Stripe (billing / pay-to-publish) ───────────────────────────────────────
# From the Stripe dashboard. Test-mode keys are fine for development.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret (Stripe CLI `stripe listen`, or the dashboard endpoint).
STRIPE_WEBHOOK_SECRET=

# Price IDs for the three tiers (create them in Stripe → Products, recurring/monthly).
STRIPE_PRICE_BASIC=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=

# ── Email (Resend — Supabase Send Email Hook sends all auth email via Resend) ─
RESEND_API_KEY=
# The From address for all app email. Use a verified domain address (NOT
# noreply) so it lands in the inbox, e.g. "Kovasite <hello@kovasite.com>".
EMAIL_FROM=Kovasite <hello@kovasite.com>
# From Supabase → Auth → Hooks → "Send Email Hook" (v1,whsec_...)
SEND_EMAIL_HOOK_SECRET=

# ── Bot protection (Cloudflare Turnstile on signup) ──────────────────────────
# Create a widget at Cloudflare → Turnstile. If unset, the check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Domains (Vercel Domains API — attach subdomains + buy custom domains) ─────
# Token needs domain read/write + purchase. Project/team IDs from Vercel.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Registrant contact for domains bought in-app (your business — you hold them).
# Required by Vercel's buy endpoint. Country is a 2-letter code (e.g. GB).
REGISTRANT_FIRST_NAME=
REGISTRANT_LAST_NAME=
REGISTRANT_EMAIL=
# E.164 preferred, e.g. +447234345654
REGISTRANT_PHONE=
REGISTRANT_ADDRESS1=
REGISTRANT_CITY=
REGISTRANT_STATE=
REGISTRANT_ZIP=
REGISTRANT_COUNTRY=
